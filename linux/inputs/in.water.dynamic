clear
units metal
boundary p p p
atom_style atomic
read_data ${data_file}
replicate ${rep_x} ${rep_y} ${rep_z}
mass 1 1.007825
mass 2 15.994915
if "${pair_name} == accelnet" then &
  "pair_style accelnet ${backend_name} ${model_1} ${model_2}" &
else &
  "pair_style aenet ${model_1} ${model_2}"
pair_coeff * *
timestep 0.0005
velocity all create 300.0 4928459
fix integrate all nve
fix thermostat all temp/csvr 300.0 300.0 1.0 54324
fix momentum_reset all momentum 100 linear 1 1 1
thermo_style custom step temp pe ke etotal press
thermo ${measure_steps}
run ${warmup_steps} post no
run ${measure_steps} pre no
