clear
units metal
boundary p p p
atom_style atomic
read_data ${data_file}
replicate 3 2 1
mass 1 1.007825
mass 2 15.994915
if "${pair_name} == accelnet" then &
  "pair_style accelnet ${backend_name} ${model_1} ${model_2}" &
else &
  "pair_style aenet ${model_1} ${model_2}"
pair_coeff * *
thermo_style custom step pe
thermo_modify format float %.17g
thermo 1
dump check all custom 1 ${dump_file} id type x y z fx fy fz
dump_modify check first yes sort id format line "%d %d %.17g %.17g %.17g %.17g %.17g %.17g"
run 0
