LAMMPS (4 Feb 2020)
clear
units metal
boundary p p p
atom_style atomic
read_data ${data_file}
read_data /home/yuki/AccelNet-lammps/examples/water/01_Start/firstframe.start
  orthogonal box = (0 0 0) to (12.4171 12.4171 12.4171)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  192 atoms
  read_data CPU = 0.000461303 secs
replicate ${rep_x} ${rep_y} ${rep_z}
replicate 3 ${rep_y} ${rep_z}
replicate 3 2 ${rep_z}
replicate 3 2 1
  orthogonal box = (0 0 0) to (37.2513 24.8342 12.4171)
  1 by 1 by 1 MPI processor grid
  1152 atoms
  replicate CPU = 0.000358693 secs
mass 1 1.007825
mass 2 15.994915
pair_style ${pair_name} ${model_1} ${model_2}
pair_style aenet ${model_1} ${model_2}
