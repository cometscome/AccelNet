# Synthetic two-species model for virial regression (not a physical potential).
# H uses G2/G5 direct contraction; O uses G2/G4/G5 and the full Jacobian.
number_of_elements 2
elements H O
nnp_type 2G-HDNNP
atom_energy H 0.1
atom_energy O -0.2
mean_energy 0.25
conv_energy 2.0
conv_length 1.3
cutoff_type 1 0.0
scale_symmetry_functions
scale_min_short -1.0
scale_max_short 1.0
global_hidden_layers_short 0
global_nodes_short
global_activation_short l

symfunction_short H 2 H 0.4 0.1 3.4
symfunction_short H 2 O 0.7 0.2 3.4
symfunction_short H 9 H O 0.15 1.0 2.0 3.4 0.1
symfunction_short O 2 H 0.3 0.1 3.4
symfunction_short O 2 O 0.5 0.0 3.4
symfunction_short O 3 H O 0.1 -1.0 2.0 3.4 0.2
symfunction_short O 9 H O 0.2 1.0 3.0 3.4 0.1
