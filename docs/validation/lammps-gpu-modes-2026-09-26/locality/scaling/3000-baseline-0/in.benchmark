clear
package gpu 1 neigh yes newton on split 1

units metal
atom_style atomic
boundary p p p

read_data /tmp/accelnet-lammps-gpu/validation-h100/orthogonal.data
replicate 5 5 5
pair_style accelnet/gpu moment /home/nagai/AccelNetGPU/AccelNetTrainer.jl/test/data/fortran_predict/Ti.nn.ascii /home/nagai/AccelNetGPU/AccelNetTrainer.jl/test/data/fortran_predict/O.nn.ascii
pair_coeff * *
neighbor 0.6 bin
neigh_modify every 10 delay 0 check yes
atom_modify sort 100 0.0
velocity all create 100 4928459 mom yes rot no dist gaussian
fix integrate all nve
timestep 0.0001
compute vir all pressure NULL virial
thermo 100
thermo_style custom step pe c_vir[1] c_vir[2] c_vir[3] c_vir[4] c_vir[5] c_vir[6]
thermo_modify format float %.17g lost error
run 20
run 100
compute ea all pe/atom
run 0
write_dump all custom final.dump id type x y z fx fy fz c_ea modify sort id format float %.17g
